<!doctype html>
<html lang="ar" dir="rtl">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>المباني الصناعية | لمسات الإبداع للمقاولات</title>
<style>
:root{--navy:#15394d;--gold:#c4a16d;--ink:#203647;--muted:#60727e;--bg:#eef2f4;--line:#e1e8ec}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);font-family:"Cairo","Tajawal","Noto Sans Arabic","Segoe UI",Tahoma,Arial,sans-serif;color:var(--ink)}
.page{max-width:440px;margin:0 auto;background:white;min-height:100vh;box-shadow:0 12px 42px #173f5520}
header{display:flex;justify-content:space-between;align-items:center;padding:16px 20px;background:white;border-bottom:1px solid var(--line)}
.brand{font-size:15px;font-weight:800;color:var(--navy)}.menu{font-size:25px;color:var(--navy)}
.hero{background:var(--navy);padding:30px 23px 33px;color:white}
.kicker{font-size:11px;letter-spacing:1px;color:var(--gold);direction:ltr;text-align:right;margin-bottom:12px}
h1{font-size:29px;line-height:1.45;margin:0 0 12px;font-weight:800}
h2{font-size:21px;line-height:1.65;margin:0 0 12px;font-weight:750}
.hero p{font-size:15px;line-height:2.04;margin:0;color:#eff3f5}
.gallery{padding:27px 18px 16px}
.gallery h2{color:var(--navy);font-size:22px;margin:0 0 8px}
.gallery .intro{font-size:14px;line-height:1.85;color:var(--muted);margin:0 0 18px}
.photos{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.photo{margin:0;border:1px solid var(--line);border-radius:13px;overflow:hidden;background:#fff}
.photo img{display:block;width:100%;height:152px;object-fit:cover;object-position:center}
.photo figcaption{text-align:center;font-size:13px;font-weight:650;padding:11px 5px;color:var(--navy)}
.cta{margin:10px 18px 28px;padding:23px 18px;border-radius:15px;background:var(--navy);color:white;text-align:center}
.cta h2{font-size:20px;margin:0 0 9px}.cta p{font-size:14px;line-height:1.95;color:#e9f0f3;margin:0 0 16px}
.cta a{display:inline-block;background:white;color:var(--navy);border-radius:9px;padding:11px 21px;text-decoration:none;font-weight:800;font-size:14px}
@media(min-width:760px){.page{max-width:900px}.hero{padding:45px 55px}.gallery{padding:40px 55px}.photo img{height:230px}.cta{margin:0 55px 44px}}
</style></head>
<body><main class="page">
<header><span class="brand">لمسات الإبداع للمقاولات</span><span class="menu" aria-label="القائمة">☰</span></header>
